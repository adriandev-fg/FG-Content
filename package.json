{
  "name": "fg-content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fast Growth Content: scripts for reels, posts and carousels (Instagram, TikTok, Facebook), reviewed and approved by clients.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
