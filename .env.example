# Copy to .env and fill in. Never commit .env.

# Supabase (Project settings -> API Keys). This app shares the Meristoll project; its tables are prefixed fgc_.
# The publishable key is safe in the browser; the secret key bypasses row level security and stays on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Vercel CLI (local deploys only). https://vercel.com/account/tokens
VERCEL_TOKEN=
